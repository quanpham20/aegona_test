# RPC Endpoint cho Arbitrum
# Lấy API key miễn phí từ Infura hoặc Alchemy

# Infura (Khuyến nghị)
RPC_URL=https://arbitrum-mainnet.infura.io/v3/YOUR_API_KEY_HERE

# Hoặc Alchemy
# RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_API_KEY_HERE

# Hoặc Public RPC (không khuyến nghị - có thể chậm)
# RPC_URL=https://arb1.arbitrum.io/rpc

# Hướng dẫn lấy API key:
# 
# Infura:
# 1. Đăng ký tại https://infura.io/
# 2. Tạo project mới
# 3. Chọn network: Arbitrum
# 4. Copy API key và thay thế YOUR_API_KEY_HERE ở trên
#
# Alchemy:
# 1. Đăng ký tại https://www.alchemy.com/
# 2. Tạo app mới với network Arbitrum
# 3. Copy API key và thay thế YOUR_API_KEY_HERE ở trên
